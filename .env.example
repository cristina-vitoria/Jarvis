# -------------------------------------------------------------------------
# JARVIS Acadêmico — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA suba o .env para o repositório.
# -------------------------------------------------------------------------

# --- LLM (API compatível com OpenAI, fornecida pelo professor) -----------
LLM_BASE_URL=https://sua-base-url-aqui/v1
LLM_API_KEY=seu-token-aqui
MODEL_ID=Qwen/Qwen2.5-14B-Instruct-AWQ
MAX_NEW_TOKENS=512
LLM_TIMEOUT=120

# --- RAG -----------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RAG_TOP_K=3
EMBED_MODEL=sentence-transformers/multi-qa-MiniLM-L6-cos-v1

# --- Busca Híbrida (FAISS semântico + BM25 léxico, fusão via RRF) --------
# true = ativa busca híbrida | false = usa apenas FAISS (comportamento original)
RAG_HYBRID_ENABLED=true
# Quantos candidatos buscar em cada sistema antes de fundir (RRF)
RAG_HYBRID_N_DENSE=10
RAG_HYBRID_N_SPARSE=10
