# Copie este arquivo para .env e preencha com seus valores

# Token de acesso do Hugging Face (obrigatório para Gemma 12B)
HF_TOKEN=seu_token_aqui

# ID do modelo (padrão: Gemma 12B)
MODEL_ID=google/gemma-3-12b-it

# Configurações de geração
MAX_NEW_TOKENS=512

# Configurações do RAG
CHUNK_SIZE=700
CHUNK_OVERLAP=120
RAG_TOP_K=3
EMBED_MODEL=sentence-transformers/multi-qa-MiniLM-L6-cos-v1
