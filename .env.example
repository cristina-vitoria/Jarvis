# -------------------------------------------------------------------------
# JARVIS Acadêmico — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA suba o .env para o repositório.
# -------------------------------------------------------------------------

# --- LLM (API compatível com OpenAI, fornecida pelo professor) -----------
LLM_BASE_URL=https://sua-base-url-aqui/v1
LLM_API_KEY=seu-token-aqui

# Modelo a ser usado
MODEL_ID=Qwen/Qwen2.5-14B-Instruct-AWQ

# Tokens máximos gerados por chamada de inferência
MAX_NEW_TOKENS=512

# Timeout em segundos para chamadas ao LLM
# Aumente se a API do professor for lenta ou instável (ex: 180)
LLM_TIMEOUT=120

# --- RAG -----------------------------------------------------------------
# Tamanho máximo de cada chunk em caracteres.
# Com o chunking semântico por headings, a maioria das seções de slides
# tem 300-600 chars e cabe inteira num chunk. Este valor só entra em jogo
# quando uma seção é muito longa (slides densos, OCR puro).
# Valor 1000 evita cortar slides típicos ao meio.
CHUNK_SIZE=1000

# Sobreposíção entre sub-chunks de seções longas (em caracteres).
# Ratio overlap/chunk_size ~15 % é o ideal para contexto sem desperdício.
CHUNK_OVERLAP=150

# Número de chunks retornados pelo retriever por consulta
RAG_TOP_K=3

# Modelo de embeddings (sentence-transformers, baixado automaticamente)
EMBED_MODEL=sentence-transformers/multi-qa-MiniLM-L6-cos-v1
