# -------------------------------------------------------------------------
# JARVIS Acadêmico — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA suba o .env para o repositório.
# -------------------------------------------------------------------------

# --- LLM (API compatível com OpenAI, fornecida pelo professor) -----------
LLM_BASE_URL=https://sua-base-url-aqui/v1
LLM_API_KEY=seu-token-aqui

# Modelo a ser usado
MODEL_ID=Qwen/Qwen2.5-14B-Instruct-AWQ

# Tokens máximos gerados por chamada de inferência
MAX_NEW_TOKENS=512

# Timeout em segundos para chamadas ao LLM
# Aumente se a API do professor for lenta ou instavel (ex: 180)
LLM_TIMEOUT=120

# --- RAG -----------------------------------------------------------------
# Tamanho de cada chunk em caracteres
CHUNK_SIZE=700

# Sobreposicao entre chunks consecutivos (em caracteres)
CHUNK_OVERLAP=120

# Numero de chunks retornados pelo retriever por consulta
RAG_TOP_K=3

# Modelo de embeddings (sentence-transformers, baixado automaticamente)
EMBED_MODEL=sentence-transformers/multi-qa-MiniLM-L6-cos-v1
